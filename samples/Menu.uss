/* Estilos del menú principal */
:root {
    --accent: #57C93F;
}

.menu {
    flex-direction: column;
    background-color: rgba(18, 18, 18, 0.9);
    padding: 16px;
}

.menu__title {
    font-size: 32px;
    -unity-font-style: bold;
    color: var(--accent);
}

#play:hover {
    scale: 1.05 1.05;
    transition-duration: 0.2s;
}
